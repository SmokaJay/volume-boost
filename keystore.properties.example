# Copy to keystore.properties (gitignored) and fill in your own values.
# Generate a keystore with Android Studio or:
#   keytool -genkey -v -keystore keystore/your-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias your-alias
storeFile=keystore/your-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
